{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node16",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "node16",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@aac-common": ["./libs/common"],
      "@aac-common/*": ["./libs/common/*"],
      "agent-j-generator": ["./tools/agent-j-generator/src/index.ts"],
      "@agentj/agent-j-generator": ["./tools/agent-j-generator/src/index.ts"],
      "@agentj/husky-checks": ["./libs/agent-j-husky-checks/src/index.ts"],
      "@agent-j/agent-j-components": ["./libs/agent-j-components/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
